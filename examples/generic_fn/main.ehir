fn sum[T](a: T, b: T) -> T {
  $entry:
    c = add a, b
    ret c
}

fn main() -> u32 {
  $entry:
    a_1: u32 = lcpos 1_u32
    b_1: u32 = lcpos 2_u32

    a_2: u16 = lcpos 3_u16
    b_2: u16 = lcpos 4_u16

    br $sum_it
  $sum_it:
    c_1 = call sum[u32](a_1, b_1)
    c_2 = call sum(a_2, b_2)
    c_2_u32 = cast c_2, u32
    s = sum(c_1, c_2_u32)
    ret s
}
