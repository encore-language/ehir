fn main() -> u8 {
  $entry:
    var = cpos 0_u8
    switch var, $default {
        0_u8 => $case_zero
        1_u8 => $case_one
    }
  $case_zero:
    res = call increment(var)
    ret res
  $case_one:
    cbr var, $case_zero, $default
  $default:
    br $case_zero
}

fn increment(value: u8) -> u8 {
  $entry:
    one = cpos 1_u8
    res = add value, one
    ret res
}
