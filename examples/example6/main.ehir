struct ComponentA {
    field1: u16*
    field2: ComponentB<H>
}

struct ComponentB {
    field3: u32*
}

fn main() -> u16 {
  $entry:
    f1 = cpos 14_u16
    f3 = cpos 16_u32
    b = scsoh ComponentB(f3)
    a = scsoh ComponentA(f1, b)
    br $sum_it
  $sum_it:
    e1_ptr = getfield a > field1
    e2_ptr = getfield a > field2 > field3
    e2_u32 = load e2_ptr
    e1 = load e1_ptr
    e2 = pcast e2_u32, u16
    res = add e1, e2
    ret res
}
