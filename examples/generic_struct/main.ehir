struct Vector3D[A] {
    x: A
    y: A
    z: A
}

fn get_sum_of_coords[T](vec: Vector3D[T]) -> T {
  $entry:
    x = getfield vec, x
    y = getfield vec, y
    z = getfield vec, z

    xy = add x, y
    xyz = add xy, z
    ret xyz
}

fn main() -> u32 {
  $entry:
    x_1: u32 = lcpos 1_u32
    y_1: u32 = lcpos 2_u32
    z_1: u32 = lcpos 3_u32
    vec1: Vector3D[u32] = Vector3D[u32](x_1, y_1, z_1)

    x_2: u16 = lcpos 3_u16
    y_2: u16 = lcpos 4_u16
    z_2: u16 = lcpos 5_u16
    vec2: Vector3D[u16] = Vector3D[u16](x_2, y_2, z_2)

    br $sum_it
  $sum_it:
    s_1 = call get_sum_of_coords[u32](vec1)
    s_2_u16 = call get_sum_of_coords[u16](vec2)
    s_2 = pcast s_2, u32
    s = add s_1, s_2
    ret s
}
